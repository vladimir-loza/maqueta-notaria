  "components": [
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "boton-primario",
      "description": "Acción principal del encabezado; uno por pantalla.",
      "html": "<button class=\"ds-btn-primario\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>Nuevo expediente</button>",
      "css": ".ds-btn-primario{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 14px;font:500 14px/1 'Public Sans',system-ui,sans-serif;color:#fff;background:var(--color-tinta,#1d4fa3);border:1px solid var(--color-tinta,#1d4fa3);border-radius:6px;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-btn-primario:hover{background:var(--color-tinta-hondo,#163d80);border-color:var(--color-tinta-hondo,#163d80)}.ds-btn-primario:focus-visible{outline:2px solid var(--color-tinta,#1d4fa3);outline-offset:2px}.ds-btn-primario:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "boton-secundario",
      "description": "Variante por defecto: acciones de apoyo.",
      "html": "<button class=\"ds-btn-secundario\">Descartar</button>",
      "css": ".ds-btn-secundario{display:inline-flex;align-items:center;height:36px;padding:0 14px;font:500 14px/1 'Public Sans',system-ui,sans-serif;color:var(--color-texto,#1e2329);background:var(--color-hoja,#fff);border:1px solid #c3ccd6;border-radius:6px;cursor:pointer;transition:color .15s,border-color .15s}.ds-btn-secundario:hover{color:var(--color-tinta,#1d4fa3);border-color:var(--color-tinta,#1d4fa3)}.ds-btn-secundario:focus-visible{outline:2px solid var(--color-tinta,#1d4fa3);outline-offset:2px}"
    },
    {
      "name": "Botón fantasma chico",
      "kind": "button",
      "refersTo": "boton-fantasma",
      "description": "Acciones de fila: Reabrir, Marcar enviado, eliminar.",
      "html": "<button class=\"ds-btn-fantasma\">Reabrir</button>",
      "css": ".ds-btn-fantasma{display:inline-flex;align-items:center;height:28px;padding:0 10px;font:500 13px/1 'Public Sans',system-ui,sans-serif;color:var(--color-tinta,#1d4fa3);background:transparent;border:1px solid transparent;border-radius:6px;cursor:pointer;transition:background-color .15s}.ds-btn-fantasma:hover{background:rgb(201 216 238 / .5)}.ds-btn-fantasma:focus-visible{outline:2px solid var(--color-tinta,#1d4fa3);outline-offset:2px}"
    },
    {
      "name": "Botón de peligro",
      "kind": "button",
      "refersTo": "boton-peligro",
      "description": "Acción destructiva o de salida sin guardar.",
      "html": "<button class=\"ds-btn-peligro\">Salir sin guardar</button>",
      "css": ".ds-btn-peligro{display:inline-flex;align-items:center;height:36px;padding:0 14px;font:500 14px/1 'Public Sans',system-ui,sans-serif;color:var(--color-plumon-hondo,#9e1f1d);background:var(--color-hoja,#fff);border:1px solid #e4b3b2;border-radius:6px;cursor:pointer;transition:background-color .15s}.ds-btn-peligro:hover{background:var(--color-plumon-claro,#fbe3e2)}.ds-btn-peligro:focus-visible{outline:2px solid var(--color-tinta,#1d4fa3);outline-offset:2px}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "entrada",
      "description": "Etiqueta 13px arriba, control de 36px con foco tinta.",
      "html": "<label class=\"ds-campo\"><span>Concepto</span><input class=\"ds-entrada\" placeholder=\"Ej. Avalúo comercial\"></label>",
      "css": ".ds-campo{display:flex;flex-direction:column;gap:4px;font:500 13px 'Public Sans',system-ui,sans-serif;color:var(--color-sub,#56606b)}.ds-entrada{height:36px;padding:0 10px;font:400 14px 'Public Sans',system-ui,sans-serif;color:var(--color-texto,#1e2329);background:var(--color-hoja,#fff);border:1px solid #c3ccd6;border-radius:6px;caret-color:var(--color-tinta,#1d4fa3)}.ds-entrada::placeholder{color:#56606b}.ds-entrada:hover{border-color:#9aa8b8}.ds-entrada:focus{outline:none;border-color:var(--color-tinta,#1d4fa3);box-shadow:0 0 0 2px rgb(29 79 163 / .2)}"
    },
    {
      "name": "Etiquetas de estado",
      "kind": "chip",
      "refersTo": "etiqueta-vencido",
      "description": "Par claro/hondo de una tinta; sólo en la columna de estado.",
      "html": "<span class=\"ds-et ds-et-vencido\">Vencido</span> <span class=\"ds-et ds-et-hoy\">Hoy</span> <span class=\"ds-et ds-et-neutra\">3 días</span> <span class=\"ds-et ds-et-tiempo\">A tiempo</span>",
      "css": ".ds-et{display:inline-block;padding:2px 8px;border-radius:4px;font:600 12px/1.33 'Public Sans',system-ui,sans-serif;white-space:nowrap}.ds-et-vencido{background:var(--color-plumon-claro,#fbe3e2);color:var(--color-plumon-hondo,#9e1f1d)}.ds-et-hoy{background:var(--color-marca-claro,#fbf1bf);color:var(--color-ocre,#6b5600)}.ds-et-neutra{background:var(--color-celda,#eef2f7);color:var(--color-texto,#1e2329)}.ds-et-tiempo{background:var(--color-verde-claro,#ddefe3);color:var(--color-verde-hondo,#1f5b37)}"
    },
    {
      "name": "Riel de navegación",
      "kind": "nav",
      "refersTo": "riel",
      "description": "Riel vino de 232px; activo en papel como pestaña de agenda.",
      "html": "<nav class=\"ds-riel\"><p class=\"ds-riel-marca\">Notaría · Expedientes</p><a class=\"ds-riel-enlace ds-activo\" href=\"#\"><span>Vencimientos</span><b class=\"ds-riel-alerta\">4</b></a><a class=\"ds-riel-enlace\" href=\"#\"><span>Expedientes</span><b class=\"ds-riel-cuenta\">12</b></a><a class=\"ds-riel-enlace\" href=\"#\"><span>Cuenta corriente</span></a></nav>",
      "css": ".ds-riel{width:232px;padding:20px 16px;background:var(--color-vino,#5e1f2b);display:flex;flex-direction:column;gap:4px}.ds-riel-marca{margin:0 0 20px;padding:0 10px;font:700 15px 'Barlow Semi Condensed','Public Sans',sans-serif;letter-spacing:.04em;text-transform:uppercase;color:#fff}.ds-riel-enlace{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:6px;font:500 14px 'Public Sans',system-ui,sans-serif;color:#f3e6e8;text-decoration:none;transition:background-color .15s}.ds-riel-enlace span{flex:1}.ds-riel-enlace:hover{background:var(--color-vino-hondo,#4a1822)}.ds-riel-enlace.ds-activo{background:var(--color-papel,#f5f6f2);color:var(--color-vino,#5e1f2b)}.ds-riel-enlace:focus-visible{outline:2px solid var(--color-tinta,#1d4fa3);outline-offset:2px}.ds-riel-alerta{padding:0 6px;border-radius:9999px;background:var(--color-plumon,#c8302e);color:#fff;font:600 12px 'Public Sans',sans-serif}.ds-riel-cuenta{font:600 12px 'Public Sans',sans-serif;color:var(--color-vino-claro,#d9bfc4)}"
    },
    {
      "name": "Pestañas",
      "kind": "nav",
      "description": "Pestañas sobre hairline; activa con subrayado vino de 3px.",
      "html": "<div class=\"ds-pestanas\" role=\"tablist\"><button role=\"tab\" aria-selected=\"false\">Vencidos <b class=\"ds-alerta\">3</b></button><button role=\"tab\" aria-selected=\"true\">Esta semana <b>8</b></button><button role=\"tab\" aria-selected=\"false\">Próximos 15 días <b>11</b></button></div>",
      "css": ".ds-pestanas{display:flex;gap:4px;border-bottom:1px solid var(--color-raya,#d5deea)}.ds-pestanas button{margin-bottom:-1px;padding:10px 14px;background:none;border:0;border-bottom:3px solid transparent;font:500 14px 'Public Sans',system-ui,sans-serif;color:var(--color-sub,#56606b);cursor:pointer;transition:color .15s}.ds-pestanas button:hover{color:var(--color-texto,#1e2329)}.ds-pestanas button[aria-selected=true]{border-bottom-color:var(--color-vino,#5e1f2b);color:var(--color-texto,#1e2329)}.ds-pestanas b{margin-left:6px;font-weight:600;color:var(--color-sub,#56606b)}.ds-pestanas b.ds-alerta{color:var(--color-plumon,#c8302e)}.ds-pestanas button:focus-visible{outline:2px solid var(--color-tinta,#1d4fa3);outline-offset:2px}"
    },
    {
      "name": "Regla de días",
      "kind": "custom",
      "refersTo": "celda-regla",
      "description": "Componente firma: tira de celdas-día de 22px con hoy, inhábiles, plazo corriendo, plazo de notaría subrayado y fecha de ley circulada.",
      "html": "<div class=\"ds-regla\" role=\"img\" aria-label=\"Plazo notaría: 13 nov. Plazo de ley: 17 nov.\"><span>9</span><span class=\"ds-inh\">10</span><span class=\"ds-hoy\">11</span><span class=\"ds-corre\">12</span><span class=\"ds-corre ds-notaria\">13</span><span class=\"ds-corre\">14</span><span class=\"ds-inh\">15</span><span class=\"ds-inh\">16</span><span class=\"ds-ley\">17</span><span>18</span><span>19</span></div>",
      "css": ".ds-regla{display:flex;gap:2px;font:600 11px/1 'Barlow Semi Condensed','Public Sans',sans-serif;font-variant-numeric:tabular-nums}.ds-regla span{width:22px;height:26px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:3px;box-sizing:border-box;border-radius:3px;background:var(--color-celda,#eef2f7);color:#56606b}.ds-regla .ds-hoy{background:var(--color-marca,#f2dc4a);color:var(--color-texto,#1e2329);outline:2px solid var(--color-marca-borde,#c9ae10)}.ds-regla .ds-inh{background:repeating-linear-gradient(135deg,#f7dada 0 3px,#fff 3px 6px);color:var(--color-plumon,#c8302e)}.ds-regla .ds-corre{background:var(--color-tinta-clara,#c9d8ee);color:var(--color-tinta-hondo,#163d80)}.ds-regla .ds-notaria{box-shadow:inset 0 -4px 0 var(--color-tinta,#1d4fa3)}.ds-regla .ds-ley{border-radius:9999px;border:2px solid var(--color-plumon,#c8302e);background:var(--color-hoja,#fff);color:var(--color-plumon,#c8302e)}"
    },
    {
      "name": "Marca de estado",
